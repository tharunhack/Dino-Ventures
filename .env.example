# Copy to .env for local (non-Docker) runs. docker-compose sets these itself.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
PRETTY_LOGS=true

DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet

# Connection pool
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Give up queueing for a contended row after this long (retried automatically)
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=10000

# Automatic replay of deadlocks / serialization failures
TX_MAX_ATTEMPTS=5
TX_RETRY_BASE_MS=10
TX_RETRY_MAX_MS=250

# Host port docker-compose publishes Postgres on (change if 5432 is in use)
POSTGRES_PORT=5432
APP_PORT=3000
