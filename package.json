{
  "name": "wallet-service",
  "version": "1.0.0",
  "private": true,
  "description": "Closed-loop internal wallet service with a double-entry ledger",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "loadtest": "node scripts/load-test.js"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
